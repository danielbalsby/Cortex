{
  "name": "cortex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personligt MSK-værktøj til konsultationen: struktureret notat og kildebelagt beslutningsstøtte.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html cortex.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
